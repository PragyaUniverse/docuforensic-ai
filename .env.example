# Copy to .env and fill in only what you have. Every value here is optional: with no keys at all
# the app still runs end to end, with deterministic explanations labelled as such.
# .env is gitignored. Never commit it, paste it into chat, or show it on screen.
# Verify with: .venv/bin/python -m scripts.check_keys

# --- LLM provider keys. Comma-separated lists rotate on rate-limit or quota errors. ---
# https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# https://console.groq.com/keys
GROQ_API_KEYS=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEYS=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEYS=

# --- Model routing. Leave empty to use the defaults in llm/. Free-tier model names change. ---
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=
GROQ_MODEL_FAST=
GROQ_MODEL_STRONG=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_STRONG=

# --- Local LLM: free, no key, no quota. https://ollama.com/download ---
# Defaults: OLLAMA_BASE_URL=http://localhost:11434, OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Provider order. Default: gemini,groq,openrouter,ollama. A deterministic path always follows.
LLM_CHAIN=

# --- Behaviour ---
# true: no external network calls. A local Ollama is still used.
OFFLINE=
# true: replay LLM answers recorded from real runs. The UI labels this mode.
DEMO_CACHE=
# Redact PII before any external LLM call. Default true. Keep it on.
REDACT_PII_EXTERNAL=
LLM_TIMEOUT_S=
LLM_MAX_RETRIES=

# --- Paths and limits. Leave empty for the defaults in config/settings.py. ---
DATA_DIR=
DEMO_CASES_DIR=
LLM_CACHE_DIR=
RENDER_DPI=
MAX_UPLOAD_MB=
MAX_PAGES_PER_DOC=
LOW_OCR_CONFIDENCE=
RATE_LIMIT_PER_MINUTE=
CORS_ORIGINS=
# Enables the audit-tamper demo endpoints. Set false outside a demo.
AUDIT_TAMPER_DEMO=

# Reads handwriting locally. Run: ollama pull granite3.2-vision
OLLAMA_VISION_MODEL=

# Require a login. Create users with: .venv/bin/python scripts/create_user.py <name>
AUTH_ENABLED=
# Turn on when serving over HTTPS.
AUTH_COOKIE_SECURE=
