{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "url": "http://localhost:8000",
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
